def build_parser():
    p = argparse.ArgumentParser(
        prog="gcclite",
        description="Lecoo 斗战者 N176 性能模式控制（gcc-lite 的 Linux 版）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
示例:
  gcclite                     # 查看当前状态
  gcclite mode fullspeed      # 狂暴模式（中文别名：gcclite mode 狂暴）
  gcclite mode quiet          # 静音模式
  gcclite monitor 2           # 每 2 秒刷新一次传感器
  gcclite doctor              # 诊断安装是否完整
""")
    sub = p.add_subparsers(dest="command", metavar="命令")

    sub.add_parser("status", help="显示模式/温度/风扇/电源状态").set_defaults(func=cmd_status)

    m = sub.add_parser("mode", help="查看或设置性能模式")
    m.add_argument("value", nargs="?", help="quiet|balanced|performance|fullspeed 或中文别名")
    m.add_argument("-v", "--verbose", action="store_true", help="显示切换路径细节")
    m.set_defaults(func=cmd_mode)

    sub.add_parser("list", help="列出固件支持的模式").set_defaults(func=cmd_list)
    sub.add_parser("fan", help="读取风扇转速").set_defaults(func=cmd_fan)
    sub.add_parser("temp", help="读取 CPU 温度").set_defaults(func=cmd_temp)

    fb = sub.add_parser("fan-boost", help="风扇全速开关（对应原版 MaxFanSpeed）")
    fb.add_argument("state", choices=["on", "off"], help="on=全速 / off=自动")
    fb.set_defaults(func=lambda a: cmd_fan_boost(type("A", (), {"on": a.state == "on"})()))

    mo = sub.add_parser("monitor", help="循环刷新状态")
    mo.add_argument("interval", nargs="?", type=int, default=2, help="刷新间隔秒数（默认 2）")
    mo.set_defaults(func=cmd_monitor)

    sub.add_parser("doctor", help="安装自检").set_defaults(func=cmd_doctor)

    g = sub.add_parser("gpu-mode", help="查看/设置 GPU 模式 (hybrid|discrete|uma)")
    g.add_argument("value", nargs="?")
    g.set_defaults(func=cmd_gpu_mode)

    k = sub.add_parser("kb-mode", help="查看/设置键盘 RGB 灯效 (off|cyclic|fixed|custom)")
    k.add_argument("value", nargs="?")
    k.set_defaults(func=cmd_kb_mode)

    return p


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command is None:
        return cmd_status(args)
    return args.func(args)


if __name__ == "__main__":
    # Windows 版 gcc-lite 的调度功能（按时间段自动切模式）在 Linux 下
    # 建议用 systemd timer / cron 实现，见 linux/README.md。
    sys.exit(main())
